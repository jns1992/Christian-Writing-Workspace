{
  "identifier": "default",
  "description": "Default capabilities for CWW",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    {
      "identifier": "fs:allow-app-read",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-app-write",
      "allow": [{ "path": "$APPDATA/**" }]
    }
  ]
}
